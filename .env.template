# Copy this file to .env and fill in your token.
# football-data.org API key - register for a free key at:
# https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# Postgres connection. The default matches docker-compose.yml; run `npm run db:up`
# then `npm run db:push` to create the schema. Results are cached here so the
# football-data.org API is only called when the cache is older than ~5 minutes.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vmtipping
